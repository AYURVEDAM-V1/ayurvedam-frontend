# You do not need this file for local development.
#
# The live website address is set in .env.production and used by `npm run build`.
# Only copy this to .env.local to override that address, and note that
# .env.local also applies to `npm run build`. A build stops with an error if the
# address is not a live https:// address.
NEXT_PUBLIC_SITE_URL=https://ayurvedamwellness.com
